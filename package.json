{
  "name": "openrig-for-orca",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "build:visualizer": "node scripts/build-visualizer.mjs",
    "test": "node --test test/*.test.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:history": "node ci/check-secrets.mjs --bootstrap",
    "test:orca": "orca plugin test . --json",
    "check": "orca plugin check . --json",
    "typecheck": "tsc --noEmit -p .",
    "validate": "orca plugin validate . --json",
    "test:sandbox": "node scripts/sandbox.mjs",
    "test:topology-browser": "node scripts/test-topology-browser.mjs",
    "ci:core": "node ci/run-ci.mjs --suite core",
    "ci:orca": "node ci/run-ci.mjs --suite orca"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "mermaid": "12.3.0",
    "typescript": "^5.7.0",
    "yaml": "2.9.1"
  }
}
